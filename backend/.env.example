# Backend Environment Variables
APP_ENV=development
PORT=8000

# PostgreSQL Database
DATABASE_URL=postgresql://flare_user:flare_password@localhost:5432/flare_db

# External APIs
BESTTIME_API_KEY=your_besttime_api_key_here
RESEND_API_KEY=your_resend_api_key_here
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Auth (required: the app won't start without it)
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (dev frontend)
CORS_ORIGINS=http://localhost:4200

BESTTIME_CITY=Calgary
